<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Asso Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Asso Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <a class="sr-only sr-only-focusable" href="#main-content">Aller au contenu</a>

    <div class="app-wrapper d-flex">
      <button class="sidebar-toggle btn btn-outline-secondary d-md-none m-2" aria-expanded="true" aria-controls="main-navigation" title="Ouvrir le menu">
        <span class="visually-hidden">Basculer le menu</span>
        <!-- Simple hamburger icon -->
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <%= render 'shared/sidebar' %>

      <main id="main-content" class="flex-fill p-4">
        <%= yield %>
      </main>
    </div>

    <%= javascript_include_tag 'application' %>

    <script>
      (function(){
        var toggle = document.querySelector('.sidebar-toggle');
        var sidebar = document.querySelector('.app-sidebar');
        if(!toggle || !sidebar) return;

        var isSmall = function(){ return window.matchMedia('(max-width: 767px)').matches; };

        // initialise from localStorage
        var collapsed = localStorage.getItem('sidebar_collapsed') === 'true';
        if(collapsed && !isSmall()) {
          sidebar.classList.add('collapsed');
          toggle.setAttribute('aria-expanded', 'false');
        }

        // For small screens, use .visible to show/hide
        toggle.addEventListener('click', function(){
          if(isSmall()) {
            var visible = sidebar.classList.toggle('visible');
            toggle.setAttribute('aria-expanded', String(visible));
            // don't persist small-screen visibility
          } else {
            var isCollapsed = sidebar.classList.toggle('collapsed');
            toggle.setAttribute('aria-expanded', String(!isCollapsed));
            localStorage.setItem('sidebar_collapsed', String(isCollapsed));
          }
        });

        // keyboard accessible: allow Enter/Space
        toggle.addEventListener('keydown', function(e){
          if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle.click(); }
        });

        // close sidebar when clicking outside on small screens
        document.addEventListener('click', function(e){
          if(!isSmall()) return;
          if(!sidebar.classList.contains('visible')) return;
          var inside = sidebar.contains(e.target) || toggle.contains(e.target);
          if(!inside) sidebar.classList.remove('visible');
        });
      })();
    </script>
  </body>
</html>
